# Copy to .env for local MCP + Docker MSSQL development.
# Never commit real credentials.

# --- Local Docker development configuration ---
SERVER_NAME=127.0.0.1
DATABASE_NAME=AppDB
DATABASES=AppDB,ReportingDB
DB_USER=sa
DB_PASSWORD=Str0ng!Passw0rd
TRUST_SERVER_CERTIFICATE=true
READONLY=false
ENABLE_DDL=false

# --- Optional SQL authentication (default: SQL login with DB_USER/DB_PASSWORD) ---
# SQL_AUTH_TYPE=sql | ntlm | azure-default | azure-service-principal | azure-access-token
# DB_DOMAIN=CORP                     # ntlm
# AZURE_CLIENT_ID=                   # azure-default (user-assigned identity) or azure-service-principal
# AZURE_CLIENT_SECRET=               # azure-service-principal
# AZURE_TENANT_ID=                   # azure-service-principal
# AZURE_ACCESS_TOKEN=                # azure-access-token

# --- Optional MCP server configuration ---
# Leave SERVER_PORT unset to use the SQL Server driver default port (1433).
# SERVER_PORT=1434
# ENCRYPT=false
# CONNECTION_TIMEOUT=30
# QUERY_TIMEOUT_MS=30000
# MAX_ROWS=10000
# MAX_WRITE_ROWS=100
# REQUIRE_WRITE_PREVIEW=true
# MCP_TRANSPORT=stdio
# MCP_TRANSPORT=http
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_PORT=3333
# Public base without /mcp; the server advertises <base>/mcp.
# MCP_BASE_URL=https://mcp.example.com/services/mssql
# Require Authorization: Bearer <token> on HTTP requests.
# MCP_HTTP_AUTH_TOKEN=
# Extra hostnames accepted in Host/Origin headers (comma-separated).
# MCP_HTTP_ALLOWED_HOSTS=mcp.example.com
# Allow a non-loopback MCP_HTTP_HOST without a token (only behind another auth layer).
# MCP_HTTP_ALLOW_UNAUTHENTICATED=false

# --- Docker compose overrides (scripts/mssql-*.sh) ---
MSSQL_SA_PASSWORD=Str0ng!Passw0rd
MSSQL_HOST_PORT=1433
# MSSQL_CONTAINER_NAME=mssql-mcp-dev
