{
  "name": "@eamonboyle/mssql-mcp",
  "version": "2.0.0",
  "description": "MCP server for Microsoft SQL Server - query and manage your database with natural language in Cursor, Claude, and VS Code",
  "keywords": [
    "mcp",
    "mssql",
    "sql-server",
    "database",
    "model-context-protocol",
    "cursor",
    "claude",
    "vscode"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eamonboyle/mssql-mcp.git"
  },
  "homepage": "https://github.com/eamonboyle/mssql-mcp#readme",
  "bugs": {
    "url": "https://github.com/eamonboyle/mssql-mcp/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "dist/index.js",
  "bin": {
    "mssql-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc && node -e \"require('fs').chmodSync('dist/index.js',0o755)\"",
    "prepare": "npm run build",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "format": "prettier --write src",
    "docs:check-install-links": "node scripts/generate-install-links.mjs --check",
    "docs:update-install-links": "node scripts/generate-install-links.mjs",
    "db:up": "bash scripts/mssql-up.sh",
    "db:down": "bash scripts/mssql-down.sh",
    "db:seed": "bash scripts/mssql-seed.sh",
    "db:reset": "bash scripts/mssql-down.sh --volumes && bash scripts/mssql-up.sh",
    "test:e2e": "bash scripts/e2e-mcp-tools.sh && node scripts/e2e-protocol.mjs",
    "test:e2e:protocol": "node scripts/e2e-protocol.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/mssql": "^12.3.0",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "sprintf-js": "file:vendor/sprintf-js",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "dotenv": "^18.0.7",
    "mssql": "^12.7.4",
    "zod": "^4.6.5"
  },
  "type": "module",
  "overrides": {
    "sprintf-js": "$sprintf-js"
  }
}
